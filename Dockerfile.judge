# ---------------------------------------------------------------------------
# Portugol Studio (issue #269, parte A) -- construido do fonte.
#
# Os releases publicam so instaladores de ~123 MB, sem jar do console, entao
# nao ha o que baixar. O modulo `console` e oficial e existe para isto.
#
# JDK 11 e nao 21: o projeto usa Gradle 4.10 (2018), que nao roda em JDK
# moderno. O JAR resultante e bytecode 11 e roda sem problema sob o JDK 21 da
# imagem final -- medido.
FROM eclipse-temurin:11-jdk AS portugol-studio-builder

# Commit fixado, e nao a tag: tag se move, commit nao. Ultimo commit do
# master em 12/04/2023 -- o upstream esta parado, e por isso o pino importa
# ainda mais: nao ha release para acompanhar.
ARG PORTUGOL_STUDIO_COMMIT=5640a2e95de1c5d63c11f453c324812b4d6a8f6c

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --no-checkout https://github.com/UNIVALI-LITE/Portugol-Studio.git /src \
    && cd /src \
    && git fetch --depth 1 origin "${PORTUGOL_STUDIO_COMMIT}" \
    && git checkout --detach "${PORTUGOL_STUDIO_COMMIT}"

WORKDIR /src

# `:portugol-console` e nao `:console`: o settings.gradle renomeia todo
# subprojeto com o prefixo `portugol-`, e `:console` responde "Project
# 'console' not found".
RUN ./gradlew :portugol-console:jar --no-daemon -q

# A etapa de compilacao do juiz. Ver o docblock da classe para as quatro
# medicoes que provam que o Console nao serve para isso.
COPY docker/judge/portugol/VerificaPortugol.java /verifica/

RUN set -eux; \
    libs="$(find /src/console/build/libs -name '*.jar' | tr '\n' ':')"; \
    mkdir -p /verifica/classes; \
    javac -encoding UTF-8 -cp "$libs" -d /verifica/classes /verifica/VerificaPortugol.java; \
    test -s /verifica/classes/VerificaPortugol.class

# ---------------------------------------------------------------------------
# Scratch (issue #268) -- construido aqui, e nao baixado.
#
# O release publica binarios empacotados com `pkg`, e eles NAO RODAM nesta
# imagem. Medido: o `scratch-run_0.1.7_linux_arm64` e ELF glibc
# (`interpreter /lib/ld-linux-aarch64.so.1`), e no musl do Alpine da
# `not found`. Com `gcompat` + `libstdc++` ele avanca ate
# `Error relocating: fcntl64: symbol not found` -- o shim nao cobre binario
# de Node empacotado.
#
# O que roda e o bundle do proprio projeto: `npx webpack` produz um UNICO
# arquivo de ~645 KB que o `node` da imagem executa direto. Melhor que as
# tres alternativas: nao precisa de gcompat, nao carrega 79 MB de
# node_modules, e -- medido -- o bundle silencia os avisos
# "No storage module present" que o `src/index.js` cru manda para stderr, o
# que importa porque o juiz le stderr.
#
# Estagio separado para o node_modules da construcao nao entrar na imagem
# final.
FROM node:24-alpine AS scratch-run-builder

# Commit fixado, e nao a tag: tag se move, commit nao. Corresponde a 0.1.7.
ARG SCRATCH_RUN_COMMIT=02f11e519210f8593cdcf04f257237fc0ceb7180

RUN apk add --no-cache git \
    && git clone --no-checkout https://github.com/VNOI-Admin/scratch-run.git /src \
    && cd /src \
    && git fetch --depth 1 origin "${SCRATCH_RUN_COMMIT}" \
    && git checkout --detach "${SCRATCH_RUN_COMMIT}"

WORKDIR /src
RUN npm install --no-audit --no-fund && npx webpack

# O bundle e o unico artefato que sai daqui.
RUN test -s /src/dist/index.js

# ---------------------------------------------------------------------------
# GNU Prolog (issue #305, Lote D) -- construido do fonte.
#
# Tambem nao existe no Alpine, e o upstream (gprolog.org / ftp.gnu.org) so
# publica fonte para Linux. A ultima release e a 1.5.0, de 2021, e e ai que
# mora a unica dificuldade: ela NAO COMPILA com o gcc 15 desta imagem com as
# flags padrao. Medido, duas vezes o mesmo erro:
#
#   stacks_sigsegv.c:488: error: conflicting types for 'SIGSEGV_Handler'
#   stacks_sigsegv.c:715: error: too many arguments to function
#                                'pl_le_hook_message_box'
#
# Sao declaracoes K&R sem prototipo, que o C23 -- o padrao PADRAO do gcc 15
# -- transformou de aviso em erro. `--with-c-flags` com `-std=gnu17` volta
# o compilador ao dialeto em que o fonte foi escrito e o build passa inteiro.
# Isto esta escrito aqui porque e exatamente o tipo de coisa que, sem
# explicacao, alguem "limpa" num futuro bump e quebra a imagem.
#
# Custo medido depois disso: 27 s de `make`, 15,5 MB instalados.
FROM php:8.3-cli-alpine AS gprolog-builder

# Versao E hash. Tarball do ftp.gnu.org; o sha256 foi conferido contra o
# download em 18/09/2026.
ARG GPROLOG_VERSION=1.5.0
ARG GPROLOG_SHA256=670642b43c0faa27ebd68961efb17ebe707688f91b6809566ddd606139512c01
RUN set -eux; \
    apk add --no-cache gcc make musl-dev libc-dev; \
    wget -q "https://ftp.gnu.org/gnu/gprolog/gprolog-${GPROLOG_VERSION}.tar.gz" -O /tmp/gprolog.tar.gz; \
    echo "${GPROLOG_SHA256}  /tmp/gprolog.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/gprolog-src; \
    tar -xzf /tmp/gprolog.tar.gz -C /tmp/gprolog-src --strip-components=1; \
    cd /tmp/gprolog-src/src; \
    ./configure \
        --prefix=/opt \
        --with-install-dir=/opt/gprolog \
        --without-links-dir \
        --disable-gui-console \
        --with-c-flags="-std=gnu17 -O2 -fno-strict-aliasing -fcommon -Wno-char-subscripts"; \
    make; \
    make install; \
    test -x /opt/gprolog/bin/gplc; \
    test -x /opt/gprolog/bin/pl2wam

# ---------------------------------------------------------------------------
# SWI-Prolog (issue #305, Lote D) -- construido do fonte.
#
# Nao ha o que baixar pronto: o Alpine 3.24 nao empacota SWI-Prolog
# (`apk search -x swi-prolog` e `apk search prolog` -- so aparece o
# scryer-prolog, que e outra linguagem), e o upstream publica binario apenas
# para Debian/Ubuntu, macOS e Windows.
#
# Sobra o fonte, e ele sai de graca: MEDIDO em musl/aarch64, `ninja` leva
# 24 s e o resultado instalado ocupa 7,8 MB. Nao houve patch, flag exotica
# nem erro de compilacao.
#
# `-DSWIPL_PACKAGES=OFF` deixa de fora os pacotes opcionais (http, ssl,
# odbc, jpl, xpce...). Nenhum deles serve a um programa de maratona, e eles
# e que puxariam openssl, unixodbc e uma JVM para dentro da imagem.
#
# Estagio separado porque a arvore de build (cmake, samurai, g++ e os
# objetos) nao tem por que viajar na imagem final -- daqui sai so
# /opt/swipl.
FROM php:8.3-cli-alpine AS swipl-builder

# Versao E hash (issue #304). O `Dockerfile.judge` fixa COMMIT onde a origem
# e um clone git, porque "tag se move, commit nao"; aqui a origem e um
# arquivo servido por HTTP, e o sha256 dele e um pino mais forte do que
# qualquer nome -- se o conteudo mudar, o build para.
ARG SWIPL_VERSION=10.0.2
ARG SWIPL_SHA256=e42cc098f7b8a6051c4f79a99b55162d467098aba60f69649bdc7583f0734b57
RUN set -eux; \
    apk add --no-cache cmake samurai gcc g++ musl-dev libc-dev gmp-dev ncurses-dev zlib-dev; \
    wget -q "https://www.swi-prolog.org/download/stable/src/swipl-${SWIPL_VERSION}.tar.gz" -O /tmp/swipl.tar.gz; \
    echo "${SWIPL_SHA256}  /tmp/swipl.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/swipl-src; \
    tar -xzf /tmp/swipl.tar.gz -C /tmp/swipl-src --strip-components=1; \
    cmake -S /tmp/swipl-src -B /tmp/swipl-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/swipl \
        -DSWIPL_PACKAGES=OFF \
        -DUSE_GMP=ON; \
    ninja -C /tmp/swipl-build; \
    ninja -C /tmp/swipl-build install; \
    /opt/swipl/bin/swipl --version

# MicroHelium Auto-Judge Dockerfile
# Specialized container for code compilation and execution

FROM php:8.3-cli-alpine

LABEL maintainer="MicroHelium Team"
LABEL description="MicroHelium Auto-Judge Worker"

WORKDIR /var/www/html

# Install system dependencies for compilation -- this list must cover every
# language Language::getDefaultLanguages() marks is_active (see
# Dockerfile/Dockerfile.dev, which install the identical set for the
# queue-worker judging path; this image is the standalone autojudge:start
# worker's, and must not silently drift out of sync with it).
RUN apk add --no-cache \
    git \
    curl \
    wget \
    ca-certificates \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    libzip-dev \
    zip \
    unzip \
    icu-dev \
    oniguruma-dev \
    libxml2-dev \
    postgresql-dev \
    linux-headers \
    bubblewrap=0.12.0-r0 \
    $PHPIZE_DEPS \
    # C/C++ compilers -- issue #303: versao FIXADA.
    #
    # Tudo que compila ou executa codigo de competidor esta fixado a partir
    # daqui, e tudo que so constroi a imagem (git, curl, os -dev) nao esta.
    # O criterio e esse: o veredito de uma equipe nao pode depender do dia em
    # que a imagem foi construida. `bubblewrap` entra na lista fixada por
    # outro motivo -- e o confinamento, e uma troca silenciosa dele muda o
    # que o codigo submetido alcanca.
    gcc=15.2.0-r5 \
    g++=15.2.0-r5 \
    # Clang, EXPLICITO e nao por tabela -- issue #305.
    #
    # Ele ja estava na imagem como dependencia transitiva do `rust`, e as
    # entradas `c_clang17`/`cpp_clang` passam a ser ativas nesta mudanca. Uma
    # linguagem oferecida a equipes nao pode depender de continuar sendo
    # efeito colateral da arvore de dependencia de outra.
    clang22=22.1.3-r2 \
    make \
    musl-dev \
    libc-dev \
    libstdc++ \
    # Java -- issue #305: as DUAS LTS, lado a lado.
    #
    # Cada JDK do Alpine vive no seu proprio prefixo
    # (`/usr/lib/jvm/java-NN-openjdk`), e as entradas do catalogo apontam
    # para o caminho absoluto de cada um. Sem isso, "manter a versao antiga"
    # e so um rotulo: `javac` resolve para uma JVM so. O `kotlinc` e o
    # Portugol Studio seguem usando o `default-jvm`, que continua sendo o 21.
    openjdk21-jdk=21.0.12_p8-r0 \
    openjdk25-jdk=25.0.4_p7-r0 \
    # Python 3
    python3=3.14.7-r1 \
    py3-pip \
    # Node.js / TypeScript -- a single real runtime, not nvm: see
    # Dockerfile.dev's comment on why multiple Node majors aren't installed
    nodejs=24.18.1-r0 \
    npm=11.12.1-r0 \
    # .NET / C#
    dotnet8-sdk=8.0.131-r0 \
    # Go
    go=1.26.8-r0 \
    # Rust
    rust=1.96.1-r0 \
    # Ruby
    ruby=3.4.9-r0 \
    # Perl -- issue #305, mesma razao do clang: ja estava presente como
    # dependencia do git, e a entrada `perl` passa a ser ativa.
    perl=5.42.2-r0 \
    # COBOL -- issue #305, Lote D, e a suposicao que nao se confirmou.
    #
    # Esta entrada estava no lote das linguagens "que nao existem no Alpine e
    # precisam vir de fora". Nao e o caso: `apk search -x gnucobol` devolve
    # `gnucobol-3.2-r0`. Custou um `apk add`, nao um download.
    gnucobol=3.2-r0 \
    # Bibliotecas de EXECUCAO do SWI-Prolog construido no estagio acima --
    # medido com `ldd /opt/swipl/bin/swipl`: libgmp, libncursesw e libz. O
    # `gmp` entra na lista fixada porque e a aritmetica de precisao
    # arbitraria do Prolog: trocar de versao muda conta de competidor.
    gmp=6.3.0-r4 \
    ncurses-libs=6.6_p20260516-r0 \
    zlib=1.3.2-r0 \
    # gcompat -- issue #305, Lote D: o shim de glibc de que o Dart precisa.
    #
    # Fica registrado que o comentario do scratch-run, mais abaixo, diz que
    # o gcompat NAO resolveu para ele. As duas coisas sao verdade e foram
    # medidas: o binario empacotado com `pkg` do scratch-run morre em
    # `Error relocating: fcntl64`, e o `dart` do SDK oficial roda. O shim
    # cobre parte da glibc, nao toda -- por isso nada aqui e ativado sem
    # antes compilar e executar um programa de verdade.
    #
    # Fixado pelo mesmo criterio do bubblewrap: ele nao compila nada, mas
    # esta no caminho de execucao do codigo submetido em Dart.
    gcompat=1.1.0-r4 \
    # Process management
    procps \
    # Time limiting
    coreutils \
    # Memory limiting
    util-linux \
    # Bash for scripts -- tambem a linguagem `sh` do catalogo (#305)
    bash=5.3.9-r1 \
    # -----------------------------------------------------------------
    # Issue #305, Lote C -- linguagens cujo toolchain o Alpine publica.
    #
    # Tudo aqui foi COMPILADO E EXECUTADO num `a+b` dentro do sandbox
    # antes de entrar, e o programa quebrado correspondente foi rodado
    # para conferir que a etapa de compilacao falha (varios
    # `compile_command` do catalogo executavam o programa em vez de
    # analisa-lo -- ver os comentarios em Language::getDefaultLanguages).
    # Versao fixada pelo criterio de sempre: isto compila e executa
    # codigo de competidor.
    #
    # Custo em disco medido com `apk add --simulate` sobre a linha de
    # base de 2380,6 MiB desta imagem, nesta arquitetura (aarch64).
    #
    # Interpretadores leves (+7 MiB). `lua5.4` instala `lua5.4`/
    # `luac5.4`, sem link sem sufixo -- e por isso que o catalogo mudou
    # de `lua` para `lua5.4`.
    lua5.4=5.4.8-r0 \
    gawk=5.3.2-r2 \
    tcl=8.6.17-r1 \
    # Clojure (+19 MiB). O pacote traz um clojure.jar completo; a CLI
    # `clojure` nao serve porque resolve dependencia na rede a cada
    # partida (ver docker/judge/bin/clojure-run).
    clojure=1.12.5-r0 \
    # R (+69 MiB)
    R=4.6.0-r0 \
    # BEAM (+86 MiB pelos dois)
    elixir=1.19.6-r0 \
    erlang27=27.3.4.17-r0 \
    # Fortran e Ada (+201 MiB pelos dois; sao front-ends do mesmo GCC
    # 15.2.0 ja instalado acima, e a versao acompanha a dele)
    gfortran=15.2.0-r5 \
    gcc-gnat=15.2.0-r5 \
    # Lisp e Scheme (+292 MiB pelos quatro)
    sbcl=2.6.5-r0 \
    clisp=2.49.95_git250727-r1 \
    guile=3.0.9-r2 \
    racket=9.2-r0 \
    # Sistemas modernos (+562 MiB pelos quatro; o grosso e o LLVM que
    # ldc e crystal arrastam)
    zig=0.16.0-r1 \
    nim=2.2.0-r0 \
    crystal=1.20.3-r0 \
    ldc=1.42.0-r0 \
    # OCaml (+160 MiB)
    ocaml=4.14.3-r0 \
    # Haskell (+1442 MiB) -- e o item mais caro do lote, sozinho maior
    # que a imagem inteira antes dele, porque o GHC arrasta llvm16 e
    # clang16 proprios. Fica porque Haskell e linguagem de maratona de
    # verdade e a alternativa seria oferece-la sem poder julga-la; quem
    # precisar de imagem menor tira esta linha e a entrada `hs`.
    ghc=9.10.3-r2


# Issue #305 -- os invocadores das linguagens cujo comando de compilacao
# nao cabe numa linha de catalogo (Clojure, Racket, Tcl).
#
# Nomes proprios, e nao `java -cp ...`/`racket -e ...` escritos no
# catalogo, pela mesma razao do `scratch-run` e do `portugol-studio`: o
# roteamento por capacidade olha o PRIMEIRO TOKEN do comando, e um
# comando comecando em `java` faria toda maquina com JDK anunciar que
# sabe julgar Clojure.
COPY --chmod=755 docker/judge/bin/ /usr/local/bin/

# Issue #303 -- versao fixada tambem aqui.
#
# `npm install -g typescript` sem versao resolve para a ultima do registro a
# cada build. Medido antes desta mudanca: a imagem trazia tsc 7.0.2, sem que
# nenhum commit tivesse pedido isso.
ARG TYPESCRIPT_VERSION=7.0.2
RUN npm install -g "typescript@${TYPESCRIPT_VERSION}"

# Kotlin has no Alpine package; JetBrains only ships it as a GitHub release
# zip (pure JVM + a launcher script, arch-independent given the JDK above).
ARG KOTLIN_VERSION=2.4.20
RUN wget -q "https://github.com/JetBrains/kotlin/releases/download/v${KOTLIN_VERSION}/kotlin-compiler-${KOTLIN_VERSION}.zip" -O /tmp/kotlin.zip \
    && unzip -q /tmp/kotlin.zip -d /opt \
    && rm /tmp/kotlin.zip \
    && ln -s /opt/kotlinc/bin/kotlinc /usr/local/bin/kotlinc \
    && ln -s /opt/kotlinc/bin/kotlin /usr/local/bin/kotlin

# ---------------------------------------------------------------------------
# Scala 3 (issue #305, Lote D).
#
# Sem pacote no Alpine, e sem precisar de um: Scala e JVM pura, e esta imagem
# ja carrega dois JDKs. O que entra e o zip GENERICO da release -- o
# `scala3-3.3.8.zip`, sem sufixo de plataforma -- e nao o
# `scala3-3.3.8-aarch64-pc-linux.zip`, que traz um lancador nativo compilado
# contra glibc e nao serviria aqui.
#
# 3.3.x e a linha LTS, e nao a ultima (3.9.0): a partir da 3.5 o comando
# `scala` deixou de ser o executor classico e virou a interface do Scala CLI,
# que resolve dependencia pela rede. Um juiz nao pode depender disso.
#
# VERSAO E HASH (issue #304), e o hash nao e "o que eu baixei": e o `digest`
# que o proprio GitHub atesta para o asset
# (GET /repos/scala/scala3/releases/tags/3.3.8), conferido em 18/09/2026 --
# mesmo criterio do JPlag no Dockerfile.
ARG SCALA_VERSION=3.3.8
ARG SCALA_SHA256=777423024bb2b4c2b33e18f9c28da7cea117b39478b9bb6811baf7b1a1cf22a7
RUN set -eux; \
    wget -q "https://github.com/scala/scala3/releases/download/${SCALA_VERSION}/scala3-${SCALA_VERSION}.zip" -O /tmp/scala.zip; \
    echo "${SCALA_SHA256}  /tmp/scala.zip" | sha256sum -c -; \
    unzip -q /tmp/scala.zip -d /opt; \
    mv "/opt/scala3-${SCALA_VERSION}" /opt/scala3; \
    rm /tmp/scala.zip; \
    printf '#!/bin/sh\nJAVA_HOME=/usr/lib/jvm/java-21-openjdk\nexport JAVA_HOME\nexec /opt/scala3/bin/scalac "$@"\n' > /usr/local/bin/scalac; \
    printf '#!/bin/sh\nJAVA_HOME=/usr/lib/jvm/java-21-openjdk\nexport JAVA_HOME\nexec /opt/scala3/bin/scala "$@"\n' > /usr/local/bin/scala; \
    chmod 755 /usr/local/bin/scalac /usr/local/bin/scala; \
    mkdir -p /tmp/fumaca-scala; \
    printf 'object Fumaca { def main(args: Array[String]): Unit = println("ok") }\n' > /tmp/fumaca-scala/Fumaca.scala; \
    cd /tmp/fumaca-scala; \
    scalac Fumaca.scala; \
    test "$(scala Fumaca)" = "ok"; \
    cd /; \
    rm -rf /tmp/fumaca-scala

# ---------------------------------------------------------------------------
# Apache Groovy 4 (issue #305, Lote D).
#
# Mesma historia do Scala: sem pacote no Alpine, e JVM pura. O zip da
# distribuicao binaria e independente de arquitetura.
#
# O sha256 abaixo e o que a propria Apache publica ao lado do arquivo
# (`...zip.sha256` no archive.apache.org), conferido contra o download em
# 18/09/2026.
#
# O `JAVA_HOME` explicito nos dois invocadores nao e zelo: o `startGroovy`
# procura a JVM por JAVA_HOME antes do PATH, e amarrar isto ao JDK 21 e a
# mesma decisao que as entradas de Java do catalogo tomaram na #303 -- a
# versao que roda o codigo nao pode depender de qual JVM e a `default-jvm`
# do dia.
ARG GROOVY_VERSION=4.0.33
ARG GROOVY_SHA256=395a69a81d5e9915d360d630663c1d98534c9dec134cb267798e49370855d93d
RUN set -eux; \
    wget -q "https://archive.apache.org/dist/groovy/${GROOVY_VERSION}/distribution/apache-groovy-binary-${GROOVY_VERSION}.zip" -O /tmp/groovy.zip; \
    echo "${GROOVY_SHA256}  /tmp/groovy.zip" | sha256sum -c -; \
    unzip -q /tmp/groovy.zip -d /opt; \
    mv "/opt/groovy-${GROOVY_VERSION}" /opt/groovy; \
    rm /tmp/groovy.zip; \
    printf '#!/bin/sh\nJAVA_HOME=/usr/lib/jvm/java-21-openjdk\nexport JAVA_HOME\nexec /opt/groovy/bin/groovyc "$@"\n' > /usr/local/bin/groovyc; \
    printf '#!/bin/sh\nJAVA_HOME=/usr/lib/jvm/java-21-openjdk\nexport JAVA_HOME\nexec /opt/groovy/bin/groovy "$@"\n' > /usr/local/bin/groovy; \
    chmod 755 /usr/local/bin/groovyc /usr/local/bin/groovy; \
    mkdir -p /tmp/fumaca-groovy; \
    printf 'println "ok"\n' > /tmp/fumaca-groovy/fumaca.groovy; \
    cd /tmp/fumaca-groovy; \
    groovyc fumaca.groovy; \
    test "$(groovy fumaca.groovy)" = "ok"; \
    cd /; \
    rm -rf /tmp/fumaca-groovy

# ---------------------------------------------------------------------------
# Dart (issue #305, Lote D) -- o que se esperava que nao funcionasse.
#
# O SDK oficial e glibc e nao ha build musl. A previsao era o desfecho do
# `scratch-run`: `not found` (rc=127) num arquivo que existe e e executavel.
# Metade disso se confirmou -- sem `gcompat`, `dart --version` da exatamente
# rc=127. Com o `gcompat` instalado na lista de pacotes acima, o SDK roda, e
# nao so no `--version`: o smoke test no fim deste bloco COMPILA e EXECUTA um
# programa que le stdin.
#
# A PODA nao e economia gratuita, e por isso ela vem acompanhada do smoke
# test. O SDK descompactado ocupa 646 MB, dos quais o caminho
# `dart compile exe` nao usa nada: o servidor de analise da IDE (102 MB), o
# compilador para JavaScript (77 MB + 20 MB), o de WebAssembly (31 MB), o
# DevTools (91 MB), os runtimes com sanitizer (33 MB) e as tabelas de
# simbolos. Sobram ~265 MB. Se uma versao futura mover algo para dentro
# dessa lista, o smoke test para o build em vez de a imagem sair com um
# compilador quebrado.
#
# Versao E hash (issue #304): o sha256 e o que o proprio repositorio da
# Google publica ao lado do zip (`.sha256sum`), por arquitetura.
ARG DART_VERSION=3.13.4
ARG DART_SHA256_AARCH64=1d545609bdf9da6fb5e68fbd96a599e2836e44ee64379991bd4493ee764d2fdb
ARG DART_SHA256_X86_64=6487a10df5eab890d746d14a55f4c70bec3c1c0633f51804eb504cbc0fc395bb
RUN set -eux; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
        aarch64) dart_arch=arm64; dart_sha256="${DART_SHA256_AARCH64}" ;; \
        x86_64)  dart_arch=x64;   dart_sha256="${DART_SHA256_X86_64}" ;; \
        *) echo "Sem SDK do Dart para a arquitetura $arch" >&2; exit 1 ;; \
    esac; \
    wget -q "https://storage.googleapis.com/dart-archive/channels/stable/release/${DART_VERSION}/sdk/dartsdk-linux-${dart_arch}-release.zip" -O /tmp/dart.zip; \
    echo "${dart_sha256}  /tmp/dart.zip" | sha256sum -c -; \
    unzip -q /tmp/dart.zip -d /opt; \
    rm /tmp/dart.zip; \
    rm -rf /opt/dart-sdk/bin/resources/devtools; \
    rm -f /opt/dart-sdk/bin/dartaotruntime_asan \
          /opt/dart-sdk/bin/dartaotruntime_msan \
          /opt/dart-sdk/bin/dartaotruntime_tsan; \
    find /opt/dart-sdk -name '*.sym' -delete; \
    rm -f /opt/dart-sdk/bin/snapshots/analysis_server.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/analysis_server_aot.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/dartdevc.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/dartdevc_aot.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/dart2js_aot.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/dart2wasm_product.snapshot \
          /opt/dart-sdk/bin/snapshots/dart2bytecode.dart.snapshot \
          /opt/dart-sdk/bin/snapshots/kernel_worker_aot.dart.snapshot \
          /opt/dart-sdk/bin/utils/wasm-opt; \
    printf '#!/bin/sh\nexec /opt/dart-sdk/bin/dart "$@"\n' > /usr/local/bin/dart; \
    chmod 755 /usr/local/bin/dart; \
    mkdir -p /tmp/fumaca-dart; \
    printf 'import "dart:io";\nvoid main() { print(int.parse(stdin.readLineSync()!.trim()) + 1); }\n' > /tmp/fumaca-dart/fumaca.dart; \
    cd /tmp/fumaca-dart; \
    dart compile exe fumaca.dart -o fumaca; \
    test "$(echo 7 | ./fumaca)" = "8"; \
    cd /; \
    rm -rf /tmp/fumaca-dart

# ---------------------------------------------------------------------------
# SWI-Prolog (issue #305, Lote D). O /opt/swipl vem do estagio de build no
# topo deste arquivo; aqui entra so o invocador.
#
# `/opt` ja esta em config/autojudge.php -> sandbox_paths.
#
# O invocador existe pela regra que Scratch e Portugol Studio ja seguem:
# `MachineCapabilities::executableOf()` olha o PRIMEIRO TOKEN do comando e o
# sonda com `command -v`, entao o binario tem de se chamar `swipl` e estar no
# PATH. Um link simbolico tambem resolveria o nome, mas o `exec` com caminho
# absoluto e o que o resto do arquivo usa.
COPY --from=swipl-builder /opt/swipl /opt/swipl
RUN set -eux; \
    printf '#!/bin/sh\nexec /opt/swipl/bin/swipl "$@"\n' > /usr/local/bin/swipl; \
    chmod 755 /usr/local/bin/swipl; \
    printf 'main :- write(ok), nl.\n' > /tmp/fumaca.pl; \
    test "$(swipl --on-error=status -g main,halt -l /tmp/fumaca.pl < /dev/null)" = "ok"; \
    rm -f /tmp/fumaca.pl

# ---------------------------------------------------------------------------
# GNU Prolog (issue #305, Lote D). O /opt/gprolog vem do estagio de build no
# topo deste arquivo; aqui entram o invocador e o smoke test.
#
# O `PATH` dentro do invocador NAO e decoracao. Medido: com o `gplc`
# chamado por caminho absoluto e sem o diretorio dele no PATH, a compilacao
# morre com
#
#     error trying to execute pl2wam: No such file or directory
#
# -- o `gplc` e um motorista que chama `pl2wam`, `wam2ma`, `ma2asm` e o
# `gcc` em sequencia, e procura os tres primeiros pelo PATH, nao pelo
# diretorio de instalacao. O invocador e o lugar certo para resolver isso:
# poe a casa do GNU Prolog na frente do PATH so para esse processo.
#
# `gcc` em tempo de execucao: o ultimo passo do `gplc` e montar e linkar. O
# `gcc` da lista de pacotes acima ja cobre isso -- e e por isso que ele nao
# pode sair da imagem "porque C ja compila estaticamente".
COPY --from=gprolog-builder /opt/gprolog /opt/gprolog
RUN set -eux; \
    printf '#!/bin/sh\nPATH="/opt/gprolog/bin:$PATH"\nexport PATH\nexec /opt/gprolog/bin/gplc "$@"\n' > /usr/local/bin/gplc; \
    chmod 755 /usr/local/bin/gplc; \
    mkdir -p /tmp/fumaca-gprolog; \
    printf 'main :- write(ok), nl.\n:- initialization(main).\n' > /tmp/fumaca-gprolog/fumaca.pro; \
    cd /tmp/fumaca-gprolog; \
    gplc --no-top-level -o fumaca fumaca.pro; \
    test "$(./fumaca < /dev/null)" = "ok"; \
    cd /; \
    rm -rf /tmp/fumaca-gprolog

# Scratch (issue #268). O bundle vem do estagio acima; aqui entra so o
# arquivo e o invocador.
#
# `/opt` ja esta em config/autojudge.php -> sandbox_paths, entao isto fica
# visivel dentro do sandbox sem bind novo.
#
# O invocador existe porque `MachineCapabilities::executableOf()` olha o
# PRIMEIRO TOKEN do comando e o sonda com `command -v`: um run_command
# escrito como `node /opt/... ` anunciaria a capacidade "node", e nao
# "scratch".
COPY --from=scratch-run-builder /src/dist/index.js /opt/scratch-run/index.js
RUN printf '#!/bin/sh\nexec node /opt/scratch-run/index.js "$@"\n' > /usr/local/bin/scratch-run \
    && chmod 755 /usr/local/bin/scratch-run \
    && echo 'x' | scratch-run --version

# Portugol Studio (issue #269, parte A). O jar vem do estagio acima.
#
# O layout importa: `Console.getClassPathParaCompilacao()` monta o classpath
# lendo os jars de um diretorio `lib/` AO LADO da aplicacao -- nao e um fat
# jar solto, e achatar isso quebra a execucao.
#
# `/opt` ja esta em config/autojudge.php -> sandbox_paths.
#
# A execucao precisa de `javac` EM TEMPO DE EXECUCAO: o Portugol Studio
# compila o programa para Java e chama o compilador. Medido -- sem JDK a
# execucao morre com `Cannot run program "javac"`. O `openjdk21-jdk` acima ja
# cobre isso, e e a razao de ele nao poder virar `-jre`.
COPY --from=portugol-studio-builder /src/console/build/libs /opt/portugol-studio
COPY --from=portugol-studio-builder /verifica/classes/VerificaPortugol.class /opt/portugol-studio/

# Dois invocadores, e nao um: o roteamento por capacidade
# (`MachineCapabilities::executableOf()`) olha o PRIMEIRO TOKEN do comando e o
# sonda com `command -v`. Comandos escritos como `java -jar ...` anunciariam
# a capacidade "java", e nao "portugol_studio".
RUN set -eux; \
    printf '#!/bin/sh\nexec java -jar /opt/portugol-studio/portugol-console-2.7.5.jar "$@" -no-wait\n' \
        > /usr/local/bin/portugol-studio; \
    printf '#!/bin/sh\nexec java -cp "/opt/portugol-studio:$(find /opt/portugol-studio -name \x27*.jar\x27 | tr \x27\\n\x27 \x27:\x27)" VerificaPortugol "$@"\n' \
        > /usr/local/bin/portugol-studio-check; \
    chmod 755 /usr/local/bin/portugol-studio /usr/local/bin/portugol-studio-check; \
    printf 'programa {\n  funcao inicio() {\n    escreva("ok")\n  }\n}\n' > /tmp/fumaca.por; \
    portugol-studio-check /tmp/fumaca.por; \
    rm -f /tmp/fumaca.por

# Free Pascal has no Alpine package either; installed from the official
# per-architecture SourceForge binary tarball. See Dockerfile.dev for the
# detailed rationale (retry loop: the SourceForge download occasionally
# serves a truncated file under automated tools).
ARG FPC_VERSION=3.2.2
RUN set -eu; \
    arch="$(apk --print-arch)"; \
    case "$arch" in \
        x86_64) fpc_arch=x86_64-linux; fpc_bin=ppcx64 ;; \
        aarch64) fpc_arch=aarch64-linux; fpc_bin=ppca64 ;; \
        *) echo "Unsupported arch for FPC: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://sourceforge.net/projects/freepascal/files/Linux/${FPC_VERSION}/fpc-${FPC_VERSION}.${fpc_arch}.tar/download"; \
    tries=0; \
    until wget -q -c "$url" -O /tmp/fpc.tar && tar -tf /tmp/fpc.tar >/dev/null 2>&1; do \
        tries=$((tries + 1)); \
        [ "$tries" -ge 6 ] && { echo "Failed to download a valid FPC tarball after $tries attempts" >&2; exit 1; }; \
        rm -f /tmp/fpc.tar; \
    done; \
    mkdir -p /tmp/fpcx && tar -xf /tmp/fpc.tar -C /tmp/fpcx; \
    cd "/tmp/fpcx/fpc-${FPC_VERSION}.${fpc_arch}"; \
    tar -xf "binary.${fpc_arch}.tar" "base.${fpc_arch}.tar.gz"; \
    mkdir -p "/opt/fpc/${FPC_VERSION}"; \
    tar -xzf "base.${fpc_arch}.tar.gz" -C "/opt/fpc/${FPC_VERSION}"; \
    install -m 755 "/opt/fpc/${FPC_VERSION}/lib/fpc/${FPC_VERSION}/${fpc_bin}" /usr/local/bin/fpc; \
    printf -- '-Fu/opt/fpc/%s/lib/fpc/%s/units/%s/rtl\n-Fl/opt/fpc/%s/lib/fpc/%s/units/%s/rtl\n' \
        "$FPC_VERSION" "$FPC_VERSION" "$fpc_arch" "$FPC_VERSION" "$FPC_VERSION" "$fpc_arch" > /etc/fpc.cfg; \
    rm -rf /tmp/fpc.tar /tmp/fpcx

# Set Go environment
ENV GOPATH=/go
ENV PATH=$PATH:/go/bin

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        mysqli \
        mbstring \
        pcntl \
        bcmath \
        zip \
        intl \
        sockets

# Install Redis extension
RUN pecl install redis && docker-php-ext-enable redis

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Create judge user with limited privileges
RUN addgroup -g 1000 -S judge && \
    adduser -u 1000 -S judge -G judge && \
    adduser -u 65534 -S nobody -G nogroup 2>/dev/null || true

# Create directories for judging
RUN mkdir -p /var/www/html/storage/app/judge \
    && mkdir -p /var/www/html/storage/app/problems \
    && mkdir -p /var/www/html/storage/app/runs \
    && chown -R judge:judge /var/www/html

# Copy application files
COPY --chown=judge:judge . /var/www/html

# Install PHP dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress

# Set proper permissions
RUN chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# Environment variables for judge
ENV AUTOJUDGE_ENABLED=true
ENV AUTOJUDGE_TIME_LIMIT=10
ENV AUTOJUDGE_MEMORY_LIMIT=512

# Issue #86 -- the container starts as root and the entrypoint drops to
# judge, instead of `USER judge` doing it. A cgroup v2 subtree can only be
# delegated to uid 1000 from root, and it has to exist before the judge
# process starts so that process can already be inside it: the kernel only
# allows a migration when the caller can write the cgroup.procs of the
# common ancestor of source and destination. Nothing after this line runs
# as root -- see docker/judge/entrypoint.sh, which also degrades to a plain
# privilege drop wherever the delegation is not possible.
COPY --chmod=755 docker/judge/entrypoint.sh /usr/local/bin/judge-entrypoint

ENTRYPOINT ["/usr/local/bin/judge-entrypoint"]

CMD ["php", "artisan", "autojudge:start", "--sleep=5"]
