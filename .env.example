APP_NAME=MicroHelium
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_LOG_LEVEL=debug
APP_URL=http://localhost:8000

# Issue #397: idioma padrao da interface (pt_BR ou es). Cada pessoa pode
# trocar o seu no seletor do cabecalho.
APP_LOCALE=pt_BR
# AGPL-3.0 secao 13: se esta instalacao roda uma versao modificada, aponte
# para o fonte DELA, e nao para o repositorio de origem.
APP_SOURCE_URL=https://github.com/UnitedOpen-Source/microHelium

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Docker MySQL)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=microhelium
DB_USERNAME=microhelium
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis (Docker)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Queue
QUEUE_CONNECTION=redis

# Broadcasting
BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail (Mailpit for development)
MAIL_DRIVER=smtp
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@microhelium.local"
MAIL_FROM_NAME="${APP_NAME}"

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

# Docker Ports & User Mapping
APP_PORT=8000
APP_SSL_PORT=8443
VITE_PORT=5174
PMA_PORT=8080
MAILPIT_UI_PORT=8025
DOCKER_UID=1000
DOCKER_GID=1000

# Auto-Judge Configuration
AUTOJUDGE_ENABLED=true
AUTOJUDGE_TIME_LIMIT=10
AUTOJUDGE_MEMORY_LIMIT=512
AUTOJUDGE_MAX_FILE_SIZE=100
AUTOJUDGE_OUTPUT_LIMIT=1024
AUTOJUDGE_COMPILE_TIMEOUT=30

# Perfil de toolchain para compiladores: maratona (~2.1 GB), scripting (~2.3 GB), funcional (~4.5 GB), completo (~9.4 GB)
JUDGE_PROFILE=maratona

# Auto-Judge Sandbox & Cgroups (Avançado / Opcional)
# AUTOJUDGE_USE_BWRAP=true
# AUTOJUDGE_BWRAP_PATH=/usr/bin/bwrap
# AUTOJUDGE_TIME_PATH=/usr/bin/time
# AUTOJUDGE_CGROUP_ROOT=/sys/fs/cgroup/judge

# Vite
VITE_APP_NAME="${APP_NAME}"

# Issue #44 -- stays false until a real Animeitor consumer fixture confirms
# BOCA webcast ZIP byte-format compatibility. See docs/specs/44-webcast.md.
WEBCAST_EXPORT_ENABLED=false
WEBCAST_MAX_CREDENTIAL_LIFETIME_DAYS=30

# Issue #159 -- how long an API token issued by POST /api/tokens stays
# valid, in minutes. Sanctum's own default is "forever"; 43200 is 30 days,
# long enough to cover a contest and its practice sessions and short enough
# that a token left in a lab machine stops working on its own. Leave unset
# to keep the 30-day default; set to null only if you have a reason.
SANCTUM_TOKEN_MINUTES=43200

# Issue #186 -- por quantos dias uma maquina de julgamento pode guardar os
# dados de teste que baixou, contados desde o ultimo uso. O cache e o que
# faz um judgehost quente valer a pena, e tambem e entrada e saida
# escondidas de outras pessoas numa maquina que, por desenho, fica no rack
# de outra instituicao. `judgehost:prune` aplica o limite, e roda NA MAQUINA
# DE JULGAMENTO.
JUDGEHOST_CACHE_RETENTION_DAYS=7

# Configuração de Judgehost Remoto (caso esta instância atue como nó judgehost)
# JUDGEHOST_SERVER=
# JUDGEHOST_TOKEN=
# JUDGEHOST_WORKSPACE=judgehost

# Issue #199 -- quando o julgamento para, alguem precisa ser avisado. O
# watchdog do #45 recupera em silencio e a fila cresce sem alerta: a
# organizacao so descobre porque alguem, meia hora depois, foi olhar uma
# tela. `judging:alerts` roda no agendador, avalia as condicoes e avisa.
#
# Sem webhook os avisos continuam indo para o log de contest; o webhook e o
# que faz alguem ser incomodado na hora. Telegram, Slack ou um bipe na sala
# -- o canal se liga do outro lado, e por isso nao esta amarrado aqui.
JUDGING_ALERTS_ENABLED=true
JUDGING_ALERTS_WEBHOOK_URL=
# Quando presente, cada entrega leva X-Microhelium-Signature com o
# HMAC-SHA256 do corpo: um endpoint que aceita qualquer POST e um endpoint
# que qualquer um usa para dizer que o julgamento parou.
JUDGING_ALERTS_WEBHOOK_SECRET=
# Histerese e cooldown, em minutos. Um alerta que dispara quando alguem
# reinicia um judgehost no intervalo, ou que se repete a cada cinco minutos
# durante a prova, e um alerta que a organizacao silencia -- e um canal
# silenciado nao carrega o problema seguinte.
JUDGING_ALERTS_DWELL_MINUTES=5
JUDGING_ALERTS_REPEAT_MINUTES=60
JUDGING_ALERTS_QUEUE_DEPTH=20

# Issue #275 -- auto-cadastro em /register.
#
# Ligado (o padrao), qualquer visitante pode se cadastrar -- e a conta nasce
# DESABILITADA e sem sessao, esperando liberacao da organizacao em
# /backend/users.
#
# Desligado, a rota responde 404 e o link desaparece da tela de login. E o
# que uma instalacao que so aceita contas criadas pela organizacao quer:
# /backend/users, `teams:import` e a conta gerenciada do #47 continuam sendo
# os caminhos.
REGISTRATION_OPEN=true

# Credenciais do usuário administrador padrão criado durante a seed inicial do banco de dados.
# Caso modifique aqui, o comando 'make setup' ou 'php artisan db:seed' criará o admin com essas credenciais.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@microhelium.local
DEFAULT_ADMIN_PASSWORD=

# Similaridade e Detecção de Plágio (JPlag)
# SIMILARITY_JPLAG_VERSION=6.2.0
# SIMILARITY_JPLAG_JAR_PATH=/opt/jplag/jplag-6.2.0-jar-with-dependencies.jar
# SIMILARITY_JAVA_BINARY=java
# SIMILARITY_MAX_TEAMS=60
# SIMILARITY_MAX_PAIRS=300
# SIMILARITY_MAX_CONCURRENT_PER_CONTEST=2
# SIMILARITY_TIMEOUT_SECONDS=240
# SIMILARITY_MEMORY_LIMIT_MB=1024

# Chamados SOS & Impressão
# SOS_NOTE_MAX_LENGTH=200
# SOS_HISTORY_LIMIT=10
# PRINT_MAX_FILE_SIZE_KB=512

# Backups
# BACKUP_DIRECTORY=backups
# BACKUP_MYSQLDUMP=mysqldump

# CLICS ICPC Event Feed
# CLICS_EVENT_FEED_POLL_MS=1000
# CLICS_EVENT_FEED_KEEP_ALIVE_SECONDS=30
