<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="E2E">
            <directory>tests/E2E</directory>
        </testsuite>
        <testsuite name="Smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <clover outputFile="storage/logs/clover.xml"/>
            <html outputDirectory="storage/logs/coverage"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" on every env below: PHPUnit's PhpHandler only applies an
        env entry when force is true, or the variable isn't already set in
        the OS environment (getenv($name) is false); see
        vendor/phpunit/phpunit/src/TextUI/Configuration/PhpHandler.php. This
        suite also runs inside the live production container as a
        post-deploy smoke gate (scripts/smoke.sh, issue #54), and
        docker-compose.prod.yml sets real container env vars such as
        APP_ENV=production. Without force, an env entry here would silently
        keep "production" rather than switching to the isolated in-memory
        sqlite test config, turning a smoke check into a real migrate:fresh
        run against the production database. force="true" makes every
        override unconditional, regardless of what the process environment
        already has set.
    -->
    <php>
        <!--
            A suite roda num processo so, e o uso de memoria e cumulativo: a
            medicao chegou a 123 MB com o teto padrao do PHP em 128 MB, e a
            primeira leva de testes que passou de 1291 para 1301 estourou
            com "Allowed memory size of 134217728 bytes exhausted" dentro do
            finfo, num teste de download que nao tinha relacao nenhuma com a
            mudanca.

            O sintoma e cruel: quem quebra e o teste que por acaso pediu a
            proxima alocacao, nao quem gastou a memoria. Fixar o teto aqui
            torna a margem explicita, em vez de deixa-la depender do
            memory_limit do php.ini de cada maquina. O CI vinha passando a
            cinco megabytes do limite sem ninguem saber.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <!--
            Issue #49: the judge sandbox is mandatory in every real
            deployment (AutoJudgeService throws rather than run submitted
            code unconfined), but bubblewrap is Linux only and most of this
            suite has nothing to do with judging. Default it off here so the
            suite runs on a developer machine, and let the tests that are
            actually about confinement turn it back on and skip themselves
            when bwrap is missing: tests/Integration/JudgeSandboxConfinementTest.php
            and tests/E2E/JudgeSandboxIsolationTest.php.
        -->
        <env name="AUTOJUDGE_USE_BWRAP" value="false" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!--
            Issue #328: o event feed do CLICS e um stream que, pela spec,
            NAO TERMINA ("The feed does not terminate under normal
            circumstances"). Em producao `clics.event_feed.max_seconds` e
            null, que e isso mesmo: a conexao fica aberta a prova inteira.

            Um teto de 0 aqui significa "nao entre no laco": a fotografia e
            o backlog saem e a resposta fecha. Sem isto, todo teste que le o
            CONTEUDO do feed (EventFeedTest, ConformidadeClicsTest) ficaria
            pendurado para sempre numa conexao que nao fecha por definicao.

            Quem mede o STREAM (que a conexao continua aberta, que entrega
            evento novo depois do primeiro, que manda o newline de
            keep-alive) liga um teto positivo no proprio teste
            (EventFeedStreamingContractTest).
        -->
        <env name="CLICS_EVENT_FEED_MAX_SECONDS" value="0" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>