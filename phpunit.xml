<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="E2E">
            <directory>tests/E2E</directory>
        </testsuite>
        <testsuite name="Smoke">
            <directory>tests/Smoke</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <report>
            <clover outputFile="storage/logs/clover.xml"/>
            <html outputDirectory="storage/logs/coverage"/>
        </report>
    </coverage>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" on every env below: PHPUnit's PhpHandler only applies an
        env entry when force is true, or the variable isn't already set in
        the OS environment (getenv($name) is false); see
        vendor/phpunit/phpunit/src/TextUI/Configuration/PhpHandler.php. This
        suite also runs inside the live production container as a
        post-deploy smoke gate (scripts/smoke.sh, issue #54), and
        docker-compose.prod.yml sets real container env vars such as
        APP_ENV=production. Without force, an env entry here would silently
        keep "production" rather than switching to the isolated in-memory
        sqlite test config, turning a smoke check into a real migrate:fresh
        run against the production database. force="true" makes every
        override unconditional, regardless of what the process environment
        already has set.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>