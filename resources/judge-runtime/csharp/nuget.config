<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #49: the judge sandbox has no network
  (docs/specs/49-judge-isolation.md, "Sem rede por padrão; dependências de
  linguagem pré-instaladas na imagem"). The throwaway console project that
  compile.sh generates references no packages, but NuGet still contacts the
  default nuget.org source during restore, and the whole build then fails
  with "Unable to load the service index for source https://api.nuget.org".
  Clearing the source list makes restore fully offline.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
