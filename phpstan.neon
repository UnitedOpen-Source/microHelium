includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 2, and the level is the whole decision, so it is written down.
    #
    # Level 0 found fifteen problems and every one was real: a relation on a
    # live model pointing at a class that does not exist, two env() calls
    # that stop working the moment `config:cache` runs, and three dead
    # Laravel-5-era classes that could not even be loaded. Level 1 cost one
    # more fix.
    #
    # Level 2 was 120 errors, and they were not 120 problems. 113 were one
    # root cause: reading an attribute or calling a method on a value
    # PHPStan infers as the generic Illuminate\Database\Eloquent\Model,
    # because the relations it came through carried no generic annotation.
    # `getContestTime()` exists; the annotation did not. Annotating the
    # relations took the count from 120 to 15 -- one `@return BelongsTo<
    # Problem, $this>` on Run::problem() alone removed 23 -- and the
    # fifteen that survived were each a real statement about the code:
    #
    #   - Contest::getEndTimeAttribute() declared \DateTime and its own body
    #     called ->copy(), which \DateTime does not have;
    #   - EventImporter took `class-string<Model>` for a helper only ever
    #     called with three soft-deletable models, so withTrashed(),
    #     trashed() and restore() had nothing to resolve against;
    #   - JudgeController set an undeclared `is_overdue` attribute purely so
    #     a Blade file could read it back;
    #   - PracticeController read four query-selected aliases as if they
    #     were columns of practice_publications.
    #
    # No baseline, at any level. A baseline says "these errors are
    # acceptable" and then nobody reads the list again.
    #
    # Level 3 was measured after this pass rather than guessed at, because
    # annotating the relations changed what the higher levels can see: it
    # went from 128 errors to NINE. Eight are `@var array` docblocks on
    # Laravel-5-era Helium\ classes that need narrowing to
    # array<int, string> and friends. The ninth is Carbon stub imprecision,
    # not a defect: Contest::getEndTimeAttribute() is declared
    # ?Illuminate\Support\Carbon and that is what it really returns --
    # verified by running it, get_class() says Illuminate\Support\Carbon --
    # but Carbon's own stubs type addMinutes() as returning Carbon\Carbon,
    # so PHPStan can only prove the parent. Whoever raises the level must
    # not "fix" that by widening the annotation to something less true.
    level: 2

    paths:
        - app
